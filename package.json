{
  "name": "n8n-nodes-supersaas",
  "version": "0.1.15",
  "description": "n8n node to create webhook in SuperSaaS",
  "keywords": [
    "n8n-community-node-package",
    "supersaas",
    "scheduling",
    "booking-software"
  ],
  "license": "MIT",
  "homepage": "https://www.supersaas.com",
  "author": {
    "name": "Kaarle Kulvik",
    "email": "dev@supersaas.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuperSaaS/n8n-nodes-supersaas.git"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-icons.js",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes/**/*.ts credentials/**/*.ts",
    "lintfix": "eslint nodes/**/*.ts credentials/**/*.ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run lint && npm test"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SuperSaaSApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SuperSaaS/SuperSaaSTrigger.node.js"
    ]
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "axios": "^1.20.0",
    "eslint": "^10.8.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.7",
    "n8n-workflow": "~2.44.2",
    "prettier": "^3.9.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "overrides": {
    "form-data": "^4.0.6"
  },
  "eslintIgnore": [
    "node_modules",
    ".DS_Store",
    ".tmp",
    "tmp",
    "dist",
    "npm-debug.log*",
    "yarn.lock",
    ".vscode/launch.json"
  ]
}
